{
  "name": "obsidian-typed-codeblocks",
  "version": "0.0.0",
  "description": "Type-aware (TypeScript language service) fenced code blocks for Obsidian plugins: completion, diagnostics, hover and highlighting inside a plugin's own fences.",
  "license": "MIT",
  "author": "Ken Snyder <ken@ken.net>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./run": {
      "import": {
        "types": "./dist/run.d.ts",
        "default": "./dist/run.js"
      },
      "require": {
        "types": "./dist/run.d.cts",
        "default": "./dist/run.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:worker": "node scripts/build.ts --worker-only",
    "check:graph": "node scripts/check-graph.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/language": "^6.13.0",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "obsidian": "^1.14.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/lint": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    },
    "@lezer/lr": {
      "optional": true
    },
    "obsidian": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.39.5",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@types/node": "^22.20.5",
    "@typescript/vfs": "^1.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "inferred-types": "^1.5.11",
    "obsidian": "^1.14.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
